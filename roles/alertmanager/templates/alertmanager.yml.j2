global:

route:
  group_by: ['alertname','site']
  group_wait: 1m
  routes:
    - match:
        severity: page
      receiver: page-noc
  receiver: notify-noc

receivers:
- name: 'page-noc'
  pagerduty_configs:
{% for config in alertmanager.pagerduty_configs | default([]) %}
  - routing_key: {{ config.integration_key }}
    send_resolved: true
{% endfor %}

- name: 'notify-noc'
{% for config in alertmanager.slack_configs | default([]) %}
  slack_configs:
  - send_resolved: true
    api_url: {{ config.api_url }}
    channel: {{ config.channel }} 
    text: |-
{% raw %}
      {{ range .Alerts }}
        *Alert:* {{ .Annotations.summary }}
        *Description:* {{ .Annotations.description }}
        *Details:*
        {{ range .Labels.SortedPairs }} • *{{ .Name }}:* `{{ .Value }}`
        {{ end }}
      {{ end }}
{% endraw %}

{% endfor %}
